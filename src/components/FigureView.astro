---
import type { Figure } from '../data/projectPages';
import { rich } from '../lib/rich';
import { url } from '../lib/url';

interface Props {
  figure: Figure;
}
const { figure } = Astro.props;
---

{
  figure.src && (
    <figure class="figure">
      <img src={url(figure.src)} alt={figure.alt} width={figure.width} height={figure.height} loading="lazy" decoding="async" />
      <figcaption set:html={rich(figure.caption)} />
    </figure>
  )
}
