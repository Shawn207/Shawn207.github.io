---
// Schematic for the air-ground project: a UAV and a legged robot on one floor plan.
// The UAV senses a wide footprint and flies over walls; the legged robot senses less but goes through doors.
interface Props {
  kind: 'air-ground';
}
const { kind } = Astro.props;

const groundPath = 'M40 72 L96 56 L134 55 L180 55 L214 70 L214 100 L214 138 L130 138 L78 120 L78 100 L66 80 Z';
const airPath = 'M70 58 C 112 14, 176 16, 212 58 S 292 126, 246 154 S 112 158, 92 112 S 38 96, 70 58 Z';
---

<div class="diagram" data-diagram data-kind={kind}>
  <svg
    viewBox="0 0 320 180"
    role="img"
    aria-label="Schematic of a UAV and a legged robot exploring one floor plan. The UAV flies over the walls and senses a wide area. The legged robot follows corridors and senses a smaller area."
  >
    <defs>
      <pattern id="diagram-dots" width="12" height="12" patternUnits="userSpaceOnUse">
        <circle cx="6" cy="6" r="0.8" fill="#96b0c4" opacity="0.22"></circle>
      </pattern>
    </defs>
    <rect width="320" height="180" fill="#0d141b"></rect>
    <rect width="320" height="180" fill="url(#diagram-dots)"></rect>

    <g fill="#11464f" stroke="#8aa6bc" stroke-width="2.5" stroke-linejoin="round">
      <rect x="16" y="24" width="100" height="70"></rect>
      <rect x="152" y="24" width="152" height="62"></rect>
      <rect x="56" y="114" width="232" height="50"></rect>
      <rect x="116" y="48" width="36" height="14"></rect>
      <rect x="206" y="86" width="16" height="28"></rect>
      <rect x="70" y="94" width="16" height="20"></rect>
    </g>
    <g stroke="#11464f" stroke-width="3.6" fill="none">
      <path d="M116 49.5v11M152 49.5v11M207.5 86h13M207.5 114h13M71.5 94h13M71.5 114h13"></path>
    </g>

    <g fill="#f2c200">
      <rect x="30" y="38" width="16" height="10"></rect>
      <rect x="268" y="36" width="10" height="16"></rect>
      <rect x="148" y="138" width="16" height="10"></rect>
    </g>

    <path d={groundPath} fill="none" stroke="#ffffff" stroke-opacity="0.55" stroke-width="1.4" stroke-linejoin="round"></path>
    <path d={airPath} fill="none" stroke="#ffffff" stroke-opacity="0.5" stroke-width="1.4" stroke-dasharray="4 4"></path>

    <g class="mover" data-phase="ground">
      <circle r="11" fill="#30e8ba" fill-opacity="0.2" stroke="#30e8ba" stroke-opacity="0.7" stroke-width="1"></circle>
      <circle r="3.4" fill="#ffffff" stroke="#0d141b" stroke-width="1.2"></circle>
      <animateMotion dur="22s" repeatCount="indefinite" path={groundPath}></animateMotion>
    </g>
    <g class="mover" data-phase="air">
      <circle r="26" fill="#30e8ba" fill-opacity="0.12" stroke="#30e8ba" stroke-opacity="0.6" stroke-width="1"></circle>
      <path d="M0 -5.5 L5.5 0 L0 5.5 L-5.5 0 Z" fill="#ffffff" stroke="#0d141b" stroke-width="1.2"></path>
      <animateMotion dur="17s" repeatCount="indefinite" path={airPath}></animateMotion>
    </g>
  </svg>
</div>

<style>
  .diagram {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--ink) 12%, transparent);
    border-radius: var(--radius);
    background: var(--panel);
  }
  .diagram svg {
    width: 100%;
    height: 100%;
  }
</style>

<script>
  // Respect reduced-motion: hold the animation on one frame instead of looping.
  const still = window.matchMedia('(prefers-reduced-motion: reduce)');
  const apply = () => {
    document.querySelectorAll<SVGSVGElement>('[data-diagram] svg').forEach((svg) => {
      if (still.matches) {
        svg.setCurrentTime(6);
        svg.pauseAnimations();
      } else {
        svg.unpauseAnimations();
      }
    });
  };
  apply();
  still.addEventListener('change', apply);
</script>
