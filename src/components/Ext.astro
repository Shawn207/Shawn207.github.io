---
// A link that opens in a new tab when it leaves the site, with a note for screen readers.
import { isExternal, url } from '../lib/url';

interface Props {
  href: string;
  class?: string;
  [attr: string]: unknown;
}
const { href, class: className, ...rest } = Astro.props;
const external = isExternal(href);
---

<a
  href={url(href)}
  class={className}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  {...rest}><slot />{external && <span class="sr-only"> (opens in a new tab)</span>}</a
>
