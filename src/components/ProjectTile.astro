---
import type { Project } from '../data/projects';
import { url } from '../lib/url';
import LinkChips from './LinkChips.astro';
import LoopVideo from './LoopVideo.astro';
import VideoFacade from './VideoFacade.astro';

interface Props {
  project: Project;
  feature?: boolean;
}
const { project, feature = false } = Astro.props;
const tile = project.tile;

// Keep hyphenated words such as "air-ground" on one line.
const escape = (text: string) => text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const titleHtml = project.title
  .split(' ')
  .map((word) => (word.includes('-') ? `<span class="nowrap">${escape(word)}</span>` : escape(word)))
  .join(' ');
---

<article class:list={['project', { feature }]} id={project.id}>
  <div class="project-media">
    {
      tile?.video ? (
        <div class="tile">
          <LoopVideo src={tile.video} poster={tile.poster} label={tile.alt} />
        </div>
      ) : tile?.gif ? (
        <div class="tile">
          <img src={url(tile.gif)} alt={tile.alt} loading="lazy" decoding="async" />
        </div>
      ) : project.youtube ? (
        <VideoFacade id={project.youtube} title={project.title} decorative />
      ) : null
    }
  </div>
  <div class="project-body">
    <h3 class="project-title">
      <a href={url(project.page)} set:html={titleHtml} />
    </h3>
    <p class="project-status">{project.status}</p>
    <p class="project-blurb">{project.blurb}</p>
    <LinkChips links={project.links} />
  </div>
</article>
